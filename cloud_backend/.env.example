# AgentVerse Cloud Backend Configuration
# Copy this file to .env and update values

# Django Settings
DJANGO_SECRET_KEY=your-secret-key-change-in-production-min-50-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
DATABASE_URL=postgresql://agentverse:agentverse123@localhost:5432/agentverse_cloud

# Redis (for Channels, Celery, Cache)
REDIS_URL=redis://localhost:6379/0

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:1420

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# MinIO/S3 Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=agentverse-documents
MINIO_USE_SSL=False

# Stripe (Optional)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (SendGrid - Optional)
SENDGRID_API_KEY=
DEFAULT_FROM_EMAIL=noreply@agentverse.com

# Logging
LOG_LEVEL=INFO
