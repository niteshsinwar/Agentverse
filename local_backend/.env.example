# AgentVerse Local Backend Configuration
# Copy this file to .env and update values

# Cloud Backend Connection
CLOUD_BACKEND_URL=http://localhost:9000
CLOUD_BACKEND_WS_URL=ws://localhost:9000

# Local Database (SQLite)
DATABASE_URL=sqlite:///.agentverse/local.db

# Cache Settings
CACHE_TTL_SECONDS=300
CACHE_MAX_SIZE=1000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Device Settings (auto-generated if not set)
DEVICE_ID=
DEVICE_NAME=

# Server Settings
PORT=8000
HOST=0.0.0.0
RELOAD=True
