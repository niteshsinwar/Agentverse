# ============================================================================
# AgentVerse Local Backend - Environment Variables
# ============================================================================
#
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Generate a secure SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 3. Fill in your API keys and configuration values
#
# ============================================================================

# ---- Security (REQUIRED) ----
# CRITICAL: Generate a unique key for production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secure-random-key-here-minimum-32-characters

# ---- LLM Keys ----
OPENAI_API_KEY=
VLLM_ENDPOINT=http://localhost:8001/v1

# ---- GitHub (Required for GitHub MCP Server) ----
GITHUB_TOKEN=

# ---- Salesforce  ----
SF_USERNAME=
SF_PASSWORD=
SF_TOKEN=

# ---- Jira ----
JIRA_URL=""
EMAIL=""         # Jira email
API_TOKEN=""     # Jira API token
PROJECT_KEY="SCRUM"

# ---- Storage ----
EMBEDDINGS_MODEL=text-embedding-3-large
DATABASE_URL=sqlite:///./agentic.db

# ---- Cloud Backend Integration (Optional) ----
# Enable cloud features if you have a cloud backend running
CLOUD_ENABLED=false
CLOUD_BASE_URL=http://localhost:9000
CLOUD_API_VERSION=v1
CLOUD_TIMEOUT=30

# ---- Logging ----
LOG_LEVEL=INFO
