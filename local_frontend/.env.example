# Local Frontend Environment Variables

# API Configuration
# Local backend URL (agent execution happens here)
VITE_API_BASE_URL=http://localhost:8000

# Cloud Integration (optional)
# Enable cloud for multi-tenant config sync
VITE_CLOUD_ENABLED=false
VITE_CLOUD_BASE_URL=http://localhost:9000

# Environment
VITE_ENVIRONMENT=development

# Logging
VITE_LOG_LEVEL=info

# API Timeout
VITE_API_TIMEOUT=30000

# SSE Reconnect Interval
VITE_SSE_RECONNECT_INTERVAL=5000
