# AgentVerse Local Frontend Configuration
# Copy this file to .env and update values

# Local Backend URL (NEVER call cloud backend directly!)
VITE_LOCAL_BACKEND_URL=http://localhost:8000

# Cloud Features
VITE_CLOUD_ENABLED=true

# WebSocket URL (proxied through local_backend)
VITE_WS_URL=ws://localhost:8000

# Application Settings
VITE_APP_NAME=AgentVerse
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_DEBUG=false
